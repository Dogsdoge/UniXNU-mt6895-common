# Shared kernel configuration for MediaTek MT6895 (Dimensity 8100).
# CONFIG_XNU_<NAME> becomes XNU_<NAME> in the UniXNU kernel build.
#
# Only SoC-level gates confirmed from sources are enabled. Peripheral gates
# (UFS/display/input/GPU/power) stay off until the driver port is recorded.
#
# Sources:
#   - MT6895 mainline DTSI (GICv3, architected timer 13 MHz, PSCI=SMC)
#   - hakios-xaga/docs/BOARD.md (triple-checked against stock LK FDT + vendor_boot.dtb + live /proc/device-tree)

CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# Architected timer at 13 MHz (verified: clock-frequency = <13000000> in mt6895.dtsi)
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y

# PSCI via SMC (psci_hvc=0 on this platform) -- handled by ArmCpu/ARM DT platform
# UFS: NOT YET ported to UniXNU xnu-8796 (HakiOS uses a loader-side block service).
#       Will be enabled when the ShengUfs extent layer is ported.
# CONFIG_XNU_NATIVE_UFS is not set
# Display (GopFramebuffer) and input gates are selected at board level, not SoC level.
